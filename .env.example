# ===== 火山方舟（ARK）核心鉴权 =====
# 在 https://console.volcengine.com/ark 获取 API Key
ARK_API_KEY=your_ark_api_key_here
# 方舟接口地址（固定，一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 对话模型接入点 ID（如 doubao 系列）
ARK_MODEL_ID=your_model_endpoint_id_here

# ===== Embedding 模型接入点 ID（用于独立 retriever 示例的多模态向量化） =====
EMBEDDER=your_embedding_endpoint_id_here

# ===== MinIO 本地服务配置（当前示例未真正接线，可留默认值） =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eino-documents
MINIO_SECURE=false
